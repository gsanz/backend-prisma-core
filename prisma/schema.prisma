generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  secondname String?  @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  roleId    String?  @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  role    Role?          @relation(fields: [roleId], references: [id])
  tareas  TareaUsuario[]
  taskLogs TaskLog[]

  @@map("users")
}

model CamaraGva {
  id            String   @id @default(uuid()) @db.Uuid
  nombre        String  @db.VarChar(255)
  latitud       Decimal @db.Decimal(10, 8)
  longitud      Decimal @db.Decimal(10, 8)
  url           String  @db.Text
  fuente        String  @db.VarChar(100)
  fechaRegistro DateTime @default(now()) @map("fecha_registro") @db.Timestamptz

  @@map("camaras_gva")
}

model TareaUsuario {
  id              String   @id @default(uuid()) @db.Uuid
  nombre          String   @db.VarChar(255)
  fechaInicio     DateTime @map("fecha_inicio") @db.Date
  horasEstimadas  Decimal  @map("horas_estimadas") @db.Decimal(5, 2)
  userId          String   @map("user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  user    User      @relation(fields: [userId], references: [id])
  taskLogs TaskLog[]

  @@map("tareas_usuario")
}

model TaskLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tareaId     String   @map("tarea_id") @db.Uuid
  tareaNombre String   @map("tarea_nombre") @db.VarChar(255)
  fecha       DateTime @map("fecha") @db.Date
  descripcion String?  @db.Text
  horas       Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user  User         @relation(fields: [userId], references: [id])
  tarea TareaUsuario @relation(fields: [tareaId], references: [id])

  @@map("task_log")
  @@index([userId, fecha])
  @@index([tareaId])
}
