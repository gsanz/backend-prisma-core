generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now())
  password  String   @db.VarChar(255)
  id        String   @id @default(uuid()) @db.Uuid
}
